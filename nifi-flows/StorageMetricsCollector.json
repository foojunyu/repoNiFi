{
  "flowContents": {
    "identifier": "storage-metrics-collector-001",
    "instanceIdentifier": "storage-metrics-collector-instance",
    "name": "StorageMetricsCollector",
    "comments": "Collects NiFi repository storage metrics including FlowFile, Content, and Provenance repository disk usage.",
    "position": {"x": 1000.0, "y": 0.0},
    "processGroups": [],
    "remoteProcessGroups": [],
    "processors": [
      {
        "identifier": "generate-storage-request-001",
        "instanceIdentifier": "generate-storage-request-instance",
        "name": "GenerateFlowFile",
        "comments": "Generates trigger for storage metrics collection every 5 minutes",
        "position": {"x": 0.0, "y": 0.0},
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "generate-ff-custom-text": "{}",
          "File Size": "0B",
          "Batch Size": "1",
          "Unique FlowFiles": "false",
          "character-set": "UTF-8",
          "mime-type": "application/json"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "5 min",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "storage-metrics-collector-001"
      },
      {
        "identifier": "invoke-storage-diagnostics-001",
        "instanceIdentifier": "invoke-storage-diagnostics-instance",
        "name": "InvokeHTTP - System Diagnostics (Storage)",
        "comments": "Calls NiFi REST API to get storage usage from system diagnostics",
        "position": {"x": 0.0, "y": 200.0},
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "HTTP Method": "GET",
          "Remote URL": "${nifi.api.url}/nifi-api/system-diagnostics",
          "SSL Context Service": null,
          "Connection Timeout": "5 secs",
          "Read Timeout": "15 secs",
          "idle-timeout": "5 mins",
          "max-idle-connections": "5",
          "Include Date Header": "true",
          "Follow Redirects": "true",
          "send-message-body": "true",
          "Content-Type": "application/json"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["Failure", "No Retry", "Retry", "Original"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["Retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "storage-metrics-collector-001"
      },
      {
        "identifier": "jolt-transform-storage-001",
        "instanceIdentifier": "jolt-transform-storage-instance",
        "name": "JoltTransformJSON - Storage Metrics",
        "comments": "Transforms storage diagnostics to Elasticsearch-compatible format",
        "position": {"x": 0.0, "y": 400.0},
        "type": "org.apache.nifi.processors.standard.JoltTransformJSON",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "jolt-transform": "jolt-transform-chain",
          "jolt-spec": "[\n  {\n    \"operation\": \"shift\",\n    \"spec\": {\n      \"systemDiagnostics\": {\n        \"aggregateSnapshot\": {\n          \"flowFileRepositoryStorageUsage\": {\n            \"totalSpace\": \"flowfileRepository.totalSpace\",\n            \"usedSpace\": \"flowfileRepository.usedSpace\",\n            \"freeSpace\": \"flowfileRepository.freeSpace\",\n            \"utilization\": \"flowfileRepository.usedSpacePercent\",\n            \"storageLocation\": \"flowfileRepository.storageLocation\"\n          },\n          \"contentRepositoryStorageUsage\": {\n            \"*\": {\n              \"identifier\": \"contentRepository.containers[&1].name\",\n              \"totalSpace\": \"contentRepository.containers[&1].totalSpace\",\n              \"usedSpace\": \"contentRepository.containers[&1].usedSpace\",\n              \"freeSpace\": \"contentRepository.containers[&1].freeSpace\",\n              \"utilization\": \"contentRepository.containers[&1].usedSpacePercent\",\n              \"storageLocation\": \"contentRepository.containers[&1].storageLocation\"\n            }\n          },\n          \"provenanceRepositoryStorageUsage\": {\n            \"*\": {\n              \"identifier\": \"provenanceRepository.containers[&1].name\",\n              \"totalSpace\": \"provenanceRepository.containers[&1].totalSpace\",\n              \"usedSpace\": \"provenanceRepository.containers[&1].usedSpace\",\n              \"freeSpace\": \"provenanceRepository.containers[&1].freeSpace\",\n              \"utilization\": \"provenanceRepository.containers[&1].usedSpacePercent\",\n              \"storageLocation\": \"provenanceRepository.containers[&1].storageLocation\"\n            }\n          }\n        }\n      }\n    }\n  },\n  {\n    \"operation\": \"modify-default-beta\",\n    \"spec\": {\n      \"flowfileRepository\": {\n        \"usedSpacePercent\": 0\n      },\n      \"contentRepository\": {\n        \"usedSpacePercent\": 0\n      },\n      \"provenanceRepository\": {\n        \"usedSpacePercent\": 0\n      }\n    }\n  }\n]",
          "Transform Cache Size": "1"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "storage-metrics-collector-001"
      },
      {
        "identifier": "update-attr-storage-001",
        "instanceIdentifier": "update-attr-storage-instance",
        "name": "UpdateAttribute - Add Timestamp",
        "comments": "Adds timestamp and index info for Elasticsearch",
        "position": {"x": 0.0, "y": 600.0},
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-update-attribute-nar",
          "version": "1.23.2"
        },
        "properties": {
          "@timestamp": "${now():format('yyyy-MM-dd\\'T\\'HH:mm:ss.SSS\\'Z\\'')}",
          "elasticsearch.index": "nifi-storage-metrics-${now():format('yyyy.MM.dd')}",
          "Store State": "Do not store state"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 25,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "storage-metrics-collector-001"
      },
      {
        "identifier": "put-es-storage-001",
        "instanceIdentifier": "put-es-storage-instance",
        "name": "PutElasticsearchJson - Storage Metrics",
        "comments": "Indexes storage metrics to Elasticsearch",
        "position": {"x": 0.0, "y": 800.0},
        "type": "org.apache.nifi.processors.elasticsearch.PutElasticsearchJson",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-elasticsearch-client-service-nar",
          "version": "1.23.2"
        },
        "properties": {
          "el-rest-client-service": null,
          "el-rest-index": "${elasticsearch.index}",
          "el-rest-type": "_doc",
          "el-rest-id-attribute": null,
          "el-rest-output-error-documents": "false"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["success", "failure", "retry"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "storage-metrics-collector-001"
      }
    ],
    "inputPorts": [],
    "outputPorts": [],
    "connections": [
      {
        "identifier": "conn-gen-to-invoke-storage-001",
        "instanceIdentifier": "conn-gen-to-invoke-storage-instance",
        "name": "",
        "source": {"id": "generate-storage-request-001", "type": "PROCESSOR", "groupId": "storage-metrics-collector-001", "name": "GenerateFlowFile"},
        "destination": {"id": "invoke-storage-diagnostics-001", "type": "PROCESSOR", "groupId": "storage-metrics-collector-001", "name": "InvokeHTTP - System Diagnostics (Storage)"},
        "labelIndex": 1,
        "zIndex": 0,
        "selectedRelationships": ["success"],
        "backPressureObjectThreshold": 10000,
        "backPressureDataSizeThreshold": "1 GB",
        "flowFileExpiration": "0 sec",
        "prioritizers": [],
        "bends": [],
        "loadBalanceStrategy": "DO_NOT_LOAD_BALANCE",
        "partitioningAttribute": "",
        "loadBalanceCompression": "DO_NOT_COMPRESS",
