        "name": "",
        "source": {"id": "invoke-storage-diagnostics-001", "type": "PROCESSOR", "groupId": "storage-metrics-collector-001", "name": "InvokeHTTP - System Diagnostics (Storage)"},
        "destination": {"id": "jolt-transform-storage-001", "type": "PROCESSOR", "groupId": "storage-metrics-collector-001", "name": "JoltTransformJSON - Storage Metrics"},
