        "destination": {"id": "update-attr-storage-001", "type": "PROCESSOR", "groupId": "storage-metrics-collector-001", "name": "UpdateAttribute - Add Timestamp"},
        "labelIndex": 1,
        "zIndex": 0,
        "selectedRelationships": ["success"],
        "backPressureObjectThreshold": 10000,
        "backPressureDataSizeThreshold": "1 GB",
        "flowFileExpiration": "0 sec",
        "prioritizers": [],
        "bends": [],
        "loadBalanceStrategy": "DO_NOT_LOAD_BALANCE",
        "partitioningAttribute": "",
        "loadBalanceCompression": "DO_NOT_COMPRESS",
        "componentType": "CONNECTION",
        "groupIdentifier": "storage-metrics-collector-001"
      },
      {
        "identifier": "conn-update-to-put-storage-001",
        "instanceIdentifier": "conn-update-to-put-storage-instance",
        "name": "",
        "source": {"id": "update-attr-storage-001", "type": "PROCESSOR", "groupId": "storage-metrics-collector-001", "name": "UpdateAttribute - Add Timestamp"},
        "destination": {"id": "put-es-storage-001", "type": "PROCESSOR", "groupId": "storage-metrics-collector-001", "name": "PutElasticsearchJson - Storage Metrics"},
        "labelIndex": 1,
        "zIndex": 0,
        "selectedRelationships": ["success"],
        "backPressureObjectThreshold": 10000,
        "backPressureDataSizeThreshold": "1 GB",
        "flowFileExpiration": "0 sec",
        "prioritizers": [],
        "bends": [],
        "loadBalanceStrategy": "DO_NOT_LOAD_BALANCE",
        "partitioningAttribute": "",
        "loadBalanceCompression": "DO_NOT_COMPRESS",
        "componentType": "CONNECTION",
        "groupIdentifier": "storage-metrics-collector-001"
      }
    ],
    "labels": [
      {
        "identifier": "label-storage-001",
        "instanceIdentifier": "label-storage-instance",
        "position": {"x": -250.0, "y": 0.0},
        "label": "Storage Metrics Collection Flow\n\nCollects:\n• FlowFile Repository Usage\n• Content Repository Usage\n• Provenance Repository Usage\n• Disk Space Utilization\n\nSchedule: Every 5 minutes",
        "zIndex": 0,
        "width": 240.0,
        "height": 200.0,
        "style": {"font-size": "12px"},
