{
  "flowContents": {
    "identifier": "processor-metrics-collector-001",
    "instanceIdentifier": "processor-metrics-collector-instance",
    "name": "ProcessorMetricsCollector",
    "comments": "Collects NiFi processor-level metrics including transaction counts, errors, processing times. Enables per-processor error trends and transaction spike detection.",
    "position": {"x": 500.0, "y": 0.0},
    "processGroups": [],
    "remoteProcessGroups": [],
    "processors": [
      {
        "identifier": "generate-processor-request-001",
        "instanceIdentifier": "generate-processor-request-instance",
        "name": "GenerateFlowFile",
        "comments": "Generates trigger for processor metrics API call every 60 seconds",
        "position": {"x": 0.0, "y": 0.0},
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "generate-ff-custom-text": "{}",
          "File Size": "0B",
          "Batch Size": "1",
          "Unique FlowFiles": "false",
          "character-set": "UTF-8",
          "mime-type": "application/json"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "60 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "processor-metrics-collector-001"
      },
      {
        "identifier": "invoke-flow-process-groups-001",
        "instanceIdentifier": "invoke-flow-process-groups-instance",
        "name": "InvokeHTTP - Get Process Groups",
        "comments": "Calls NiFi REST API to get root process group with all statistics",
        "position": {"x": 0.0, "y": 200.0},
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "HTTP Method": "GET",
          "Remote URL": "${nifi.api.url}/nifi-api/flow/process-groups/root?recursive=true",
          "SSL Context Service": null,
          "Connection Timeout": "5 secs",
          "Read Timeout": "30 secs",
          "idle-timeout": "5 mins",
          "max-idle-connections": "5",
          "Include Date Header": "true",
          "Follow Redirects": "true",
          "send-message-body": "true",
          "Content-Type": "application/json"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["Failure", "No Retry", "Retry", "Original"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["Retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "processor-metrics-collector-001"
      },
      {
        "identifier": "evaluate-json-processors-001",
        "instanceIdentifier": "evaluate-json-processors-instance",
        "name": "EvaluateJsonPath - Extract Processors",
        "comments": "Extracts processor statistics array from response",
        "position": {"x": 0.0, "y": 400.0},
        "type": "org.apache.nifi.processors.standard.EvaluateJsonPath",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "Destination": "flowfile-attribute",
          "Return Type": "auto-detect",
          "Path Not Found Behavior": "ignore",
          "Null Value Representation": "empty string",
          "processGroupId": "$.processGroupFlow.id",
          "processGroupName": "$.processGroupFlow.breadcrumb.breadcrumb.name"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure", "unmatched"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "processor-metrics-collector-001"
      },
      {
        "identifier": "split-json-processors-001",
        "instanceIdentifier": "split-json-processors-instance",
        "name": "SplitJson - Split Processors",
        "comments": "Splits the response to individual processor records",
        "position": {"x": 0.0, "y": 600.0},
        "type": "org.apache.nifi.processors.standard.SplitJson",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "JsonPath Expression": "$.processGroupFlow.flow.processors[*]",
          "Null Value Representation": "empty string"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure", "original"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "processor-metrics-collector-001"
      },
      {
        "identifier": "jolt-transform-processor-001",
        "instanceIdentifier": "jolt-transform-processor-instance",
        "name": "JoltTransformJSON - Processor Metrics",
        "comments": "Transforms processor data to Elasticsearch-compatible format with error rates",
        "position": {"x": 0.0, "y": 800.0},
        "type": "org.apache.nifi.processors.standard.JoltTransformJSON",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "jolt-transform": "jolt-transform-chain",
          "jolt-spec": "[\n  {\n    \"operation\": \"shift\",\n    \"spec\": {\n      \"id\": \"processor.id\",\n      \"component\": {\n        \"id\": \"processor.componentId\",\n        \"name\": \"processor.name\",\n        \"type\": \"processor.type\",\n        \"state\": \"processor.runStatus\",\n        \"validationStatus\": \"processor.validationStatus\"\n      },\n      \"status\": {\n        \"aggregateSnapshot\": {\n          \"flowFilesIn\": \"stats.flowFilesIn\",\n          \"flowFilesOut\": \"stats.flowFilesOut\",\n          \"flowFilesRemoved\": \"stats.flowFilesRemoved\",\n          \"bytesIn\": \"stats.bytesIn\",\n          \"bytesOut\": \"stats.bytesOut\",\n          \"bytesRead\": \"stats.bytesRead\",\n          \"bytesWritten\": \"stats.bytesWritten\",\n          \"invocations\": \"stats.invocations\",\n          \"processingNanos\": \"stats.processingNanos\",\n          \"activeThreadCount\": \"stats.activeThreadCount\",\n          \"terminatedThreadCount\": \"stats.terminatedThreadCount\",\n          \"taskCount\": \"stats.taskCount\",\n          \"tasksDurationNanos\": \"stats.tasksDurationNanos\"\n        }\n      },\n      \"bulletins\": {\n        \"*\": {\n          \"bulletin\": {\n            \"message\": \"errors.lastError\",\n            \"timestamp\": \"errors.lastErrorTimestamp\"\n          }\n        }\n      }\n    }\n  },\n  {\n    \"operation\": \"modify-default-beta\",\n    \"spec\": {\n      \"stats\": {\n        \"flowFilesIn\": 0,\n        \"flowFilesOut\": 0,\n        \"invocations\": 0\n      },\n      \"errors\": {\n        \"count\": 0\n      }\n    }\n  }\n]",
          "Transform Cache Size": "1"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "processor-metrics-collector-001"
      },
      {
        "identifier": "update-attr-processor-001",
        "instanceIdentifier": "update-attr-processor-instance",
        "name": "UpdateAttribute - Add Metadata",
        "comments": "Adds timestamp and process group info",
        "position": {"x": 0.0, "y": 1000.0},
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-update-attribute-nar",
          "version": "1.23.2"
        },
        "properties": {
          "@timestamp": "${now():format('yyyy-MM-dd\\'T\\'HH:mm:ss.SSS\\'Z\\'')}",
          "elasticsearch.index": "nifi-processor-metrics-${now():format('yyyy.MM.dd')}",
          "processGroup.id": "${processGroupId}",
          "processGroup.name": "${processGroupName}",
          "Store State": "Do not store state"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 25,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "processor-metrics-collector-001"
      },
      {
        "identifier": "put-es-processor-001",
        "instanceIdentifier": "put-es-processor-instance",
        "name": "PutElasticsearchJson - Processor Metrics",
        "comments": "Indexes processor metrics to Elasticsearch",
        "position": {"x": 0.0, "y": 1200.0},
        "type": "org.apache.nifi.processors.elasticsearch.PutElasticsearchJson",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-elasticsearch-client-service-nar",
          "version": "1.23.2"
        },
        "properties": {
          "el-rest-client-service": null,
          "el-rest-index": "${elasticsearch.index}",
          "el-rest-type": "_doc",
          "el-rest-id-attribute": null,
          "el-rest-output-error-documents": "false"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["success", "failure", "retry"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "processor-metrics-collector-001"
      }
    ],
    "inputPorts": [],
    "outputPorts": [],
