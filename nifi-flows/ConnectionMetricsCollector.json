{
  "flowContents": {
    "identifier": "connection-metrics-collector-001",
    "instanceIdentifier": "connection-metrics-collector-instance",
    "name": "ConnectionMetricsCollector",
    "comments": "Collects NiFi connection/queue metrics for detecting stuck queues and back pressure conditions.",
    "position": {"x": 1500.0, "y": 0.0},
    "processGroups": [],
    "remoteProcessGroups": [],
    "processors": [
      {
        "identifier": "generate-connection-request-001",
        "instanceIdentifier": "generate-connection-request-instance",
        "name": "GenerateFlowFile",
        "comments": "Generates trigger for connection metrics collection every 30 seconds",
        "position": {"x": 0.0, "y": 0.0},
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "generate-ff-custom-text": "{}",
          "File Size": "0B",
          "Batch Size": "1",
          "Unique FlowFiles": "false",
          "character-set": "UTF-8",
          "mime-type": "application/json"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "30 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "connection-metrics-collector-001"
      },
      {
        "identifier": "invoke-flow-connections-001",
        "instanceIdentifier": "invoke-flow-connections-instance",
        "name": "InvokeHTTP - Get Process Group Flow",
        "comments": "Calls NiFi REST API to get connections from root process group",
        "position": {"x": 0.0, "y": 200.0},
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "HTTP Method": "GET",
          "Remote URL": "${nifi.api.url}/nifi-api/flow/process-groups/root?recursive=true",
          "SSL Context Service": null,
          "Connection Timeout": "5 secs",
          "Read Timeout": "30 secs",
          "idle-timeout": "5 mins",
          "max-idle-connections": "5",
          "Include Date Header": "true",
          "Follow Redirects": "true",
          "send-message-body": "true",
          "Content-Type": "application/json"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["Failure", "No Retry", "Retry", "Original"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["Retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "connection-metrics-collector-001"
      },
      {
        "identifier": "evaluate-json-connections-001",
        "instanceIdentifier": "evaluate-json-connections-instance",
        "name": "EvaluateJsonPath - Extract PG Info",
        "comments": "Extracts process group info for connection context",
        "position": {"x": 0.0, "y": 400.0},
        "type": "org.apache.nifi.processors.standard.EvaluateJsonPath",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "Destination": "flowfile-attribute",
          "Return Type": "auto-detect",
          "Path Not Found Behavior": "ignore",
          "Null Value Representation": "empty string",
          "processGroupId": "$.processGroupFlow.id",
          "processGroupName": "$.processGroupFlow.breadcrumb.breadcrumb.name"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure", "unmatched"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "connection-metrics-collector-001"
      },
      {
        "identifier": "split-json-connections-001",
        "instanceIdentifier": "split-json-connections-instance",
        "name": "SplitJson - Split Connections",
        "comments": "Splits the response to individual connection records",
        "position": {"x": 0.0, "y": 600.0},
        "type": "org.apache.nifi.processors.standard.SplitJson",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "JsonPath Expression": "$.processGroupFlow.flow.connections[*]",
          "Null Value Representation": "empty string"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure", "original"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "connection-metrics-collector-001"
      },
      {
        "identifier": "jolt-transform-connections-001",
        "instanceIdentifier": "jolt-transform-connections-instance",
        "name": "JoltTransformJSON - Connection Metrics",
        "comments": "Transforms connection data to Elasticsearch-compatible format with queue status",
        "position": {"x": 0.0, "y": 800.0},
        "type": "org.apache.nifi.processors.standard.JoltTransformJSON",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "jolt-transform": "jolt-transform-chain",
          "jolt-spec": "[\n  {\n    \"operation\": \"shift\",\n    \"spec\": {\n      \"id\": \"connection.id\",\n      \"component\": {\n        \"id\": \"connection.componentId\",\n        \"name\": \"connection.name\",\n        \"source\": {\n          \"id\": \"connection.sourceId\",\n          \"name\": \"connection.sourceName\",\n          \"type\": \"connection.sourceType\"\n        },\n        \"destination\": {\n          \"id\": \"connection.destinationId\",\n          \"name\": \"connection.destinationName\",\n          \"type\": \"connection.destinationType\"\n        },\n        \"selectedRelationships\": \"connection.selectedRelationships\",\n        \"backPressureObjectThreshold\": \"queue.backPressureObjectThreshold\",\n        \"backPressureDataSizeThreshold\": \"queue.backPressureBytesThreshold\"\n      },\n      \"status\": {\n        \"aggregateSnapshot\": {\n          \"flowFilesQueued\": \"queue.queuedCount\",\n          \"bytesQueued\": \"queue.queuedSize\",\n          \"percentUseCount\": \"queue.backPressurePercentCount\",\n          \"percentUseBytes\": \"queue.backPressurePercentSize\",\n          \"flowFilesIn\": \"stats.flowFilesIn\",\n          \"flowFilesOut\": \"stats.flowFilesOut\",\n          \"bytesIn\": \"stats.bytesIn\",\n          \"bytesOut\": \"stats.bytesOut\"\n        }\n      }\n    }\n  },\n  {\n    \"operation\": \"modify-default-beta\",\n    \"spec\": {\n      \"queue\": {\n        \"queuedCount\": 0,\n        \"queuedSize\": 0,\n        \"backPressurePercentCount\": 0,\n        \"backPressurePercentSize\": 0,\n        \"isBackPressured\": false\n      },\n      \"stuckIndicator\": {\n        \"isStuck\": false,\n        \"stuckDuration\": 0\n      }\n    }\n  }\n]",
          "Transform Cache Size": "1"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "connection-metrics-collector-001"
      },
      {
        "identifier": "update-attr-connections-001",
        "instanceIdentifier": "update-attr-connections-instance",
        "name": "UpdateAttribute - Add Metadata",
        "comments": "Adds timestamp and process group info for Elasticsearch",
        "position": {"x": 0.0, "y": 1000.0},
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-update-attribute-nar",
          "version": "1.23.2"
        },
        "properties": {
          "@timestamp": "${now():format('yyyy-MM-dd\\'T\\'HH:mm:ss.SSS\\'Z\\'')}",
          "elasticsearch.index": "nifi-connection-metrics-${now():format('yyyy.MM.dd')}",
          "processGroup.id": "${processGroupId}",
          "processGroup.name": "${processGroupName}",
          "Store State": "Do not store state"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 25,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "connection-metrics-collector-001"
      },
      {
        "identifier": "put-es-connections-001",
        "instanceIdentifier": "put-es-connections-instance",
        "name": "PutElasticsearchJson - Connection Metrics",
        "comments": "Indexes connection metrics to Elasticsearch",
        "position": {"x": 0.0, "y": 1200.0},
        "type": "org.apache.nifi.processors.elasticsearch.PutElasticsearchJson",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-elasticsearch-client-service-nar",
          "version": "1.23.2"
        },
        "properties": {
          "el-rest-client-service": null,
          "el-rest-index": "${elasticsearch.index}",
          "el-rest-type": "_doc",
          "el-rest-id-attribute": null,
          "el-rest-output-error-documents": "false"
        },
        "propertyDescriptors": {},
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["success", "failure", "retry"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "connection-metrics-collector-001"
      }
    ],
    "inputPorts": [],
    "outputPorts": [],
