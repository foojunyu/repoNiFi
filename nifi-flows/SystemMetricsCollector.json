{
  "flowContents": {
    "identifier": "system-metrics-collector-001",
    "instanceIdentifier": "system-metrics-collector-instance",
    "name": "SystemMetricsCollector",
    "comments": "Collects NiFi system diagnostics including JVM heap, GC, CPU, threads, and uptime metrics. Sends to Elasticsearch.",
    "position": {"x": 0.0, "y": 0.0},
    "processGroups": [],
    "remoteProcessGroups": [],
    "processors": [
      {
        "identifier": "generate-system-request-001",
        "instanceIdentifier": "generate-system-request-instance",
        "name": "GenerateFlowFile",
        "comments": "Generates trigger for system diagnostics API call every 30 seconds",
        "position": {"x": 0.0, "y": 0.0},
        "type": "org.apache.nifi.processors.standard.GenerateFlowFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "generate-ff-custom-text": "{}",
          "File Size": "0B",
          "Batch Size": "1",
          "Unique FlowFiles": "false",
          "character-set": "UTF-8",
          "mime-type": "application/json"
        },
        "propertyDescriptors": {
          "generate-ff-custom-text": {"name": "generate-ff-custom-text", "displayName": "Custom Text", "identifiesControllerService": false, "sensitive": false},
          "File Size": {"name": "File Size", "displayName": "File Size", "identifiesControllerService": false, "sensitive": false},
          "Batch Size": {"name": "Batch Size", "displayName": "Batch Size", "identifiesControllerService": false, "sensitive": false}
        },
        "style": {},
        "schedulingPeriod": "30 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "system-metrics-collector-001"
      },
      {
        "identifier": "invoke-system-diagnostics-001",
        "instanceIdentifier": "invoke-system-diagnostics-instance",
        "name": "InvokeHTTP - System Diagnostics",
        "comments": "Calls NiFi REST API to get system diagnostics",
        "position": {"x": 0.0, "y": 200.0},
        "type": "org.apache.nifi.processors.standard.InvokeHTTP",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "HTTP Method": "GET",
          "Remote URL": "${nifi.api.url}/nifi-api/system-diagnostics",
          "SSL Context Service": null,
          "Connection Timeout": "5 secs",
          "Read Timeout": "15 secs",
          "idle-timeout": "5 mins",
          "max-idle-connections": "5",
          "Include Date Header": "true",
          "Follow Redirects": "true",
          "send-message-body": "true",
          "Add Response Headers to Request": "false",
          "Content-Type": "application/json",
          "response-body-attribute-name": null,
          "response-body-attribute-size": "256",
          "response-cache-size": "10 MB",
          "response-redirects-cookie-attribute-name": null
        },
        "propertyDescriptors": {
          "HTTP Method": {"name": "HTTP Method", "displayName": "HTTP Method", "identifiesControllerService": false, "sensitive": false},
          "Remote URL": {"name": "Remote URL", "displayName": "Remote URL", "identifiesControllerService": false, "sensitive": false},
          "SSL Context Service": {"name": "SSL Context Service", "displayName": "SSL Context Service", "identifiesControllerService": true, "sensitive": false}
        },
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["Failure", "No Retry", "Retry"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["Retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "system-metrics-collector-001"
      },
      {
        "identifier": "jolt-transform-system-001",
        "instanceIdentifier": "jolt-transform-system-instance",
        "name": "JoltTransformJSON - System Metrics",
        "comments": "Transforms NiFi system diagnostics response to Elasticsearch-compatible format",
        "position": {"x": 0.0, "y": 400.0},
        "type": "org.apache.nifi.processors.standard.JoltTransformJSON",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "jolt-transform": "jolt-transform-chain",
          "jolt-spec": "[\n  {\n    \"operation\": \"shift\",\n    \"spec\": {\n      \"systemDiagnostics\": {\n        \"aggregateSnapshot\": {\n          \"totalHeap\": \"jvm.heap.max\",\n          \"usedHeap\": \"jvm.heap.used\",\n          \"freeHeap\": \"jvm.heap.free\",\n          \"maxHeap\": \"jvm.heap.maxAllocated\",\n          \"heapUtilization\": \"jvm.heap.usedPercent\",\n          \"totalNonHeap\": \"jvm.heap.totalNonHeap\",\n          \"usedNonHeap\": \"jvm.heap.usedNonHeap\",\n          \"freeNonHeap\": \"jvm.heap.freeNonHeap\",\n          \"availableProcessors\": \"system.cpu.availableProcessors\",\n          \"processorLoadAverage\": \"system.cpu.processorLoadAverage\",\n          \"totalThreads\": \"jvm.totalThreadCount\",\n          \"daemonThreads\": \"jvm.daemonThreadCount\",\n          \"uptime\": \"jvm.uptime\",\n          \"flowFileRepositoryStorageUsage\": {\n            \"totalSpace\": \"flowfileRepository.totalSpace\",\n            \"usedSpace\": \"flowfileRepository.usedSpace\",\n            \"freeSpace\": \"flowfileRepository.freeSpace\",\n            \"utilization\": \"flowfileRepository.usedSpacePercent\"\n          },\n          \"garbageCollection\": {\n            \"*\": {\n              \"name\": \"jvm.gc.&1.name\",\n              \"collectionCount\": \"jvm.gc.&1.collectionCount\",\n              \"collectionTime\": \"jvm.gc.&1.collectionTime\"\n            }\n          }\n        },\n        \"nodeSnapshots\": {\n          \"*\": {\n            \"nodeId\": \"cluster.nodeId\",\n            \"address\": \"cluster.nodeAddress\"\n          }\n        }\n      }\n    }\n  },\n  {\n    \"operation\": \"default\",\n    \"spec\": {\n      \"@timestamp\": \"${now():format('yyyy-MM-dd\\'T\\'HH:mm:ss.SSS\\'Z\\'')}\" \n    }\n  }\n]",
          "Transform Cache Size": "1",
          "Validate Transformation": "true"
        },
        "propertyDescriptors": {
          "jolt-transform": {"name": "jolt-transform", "displayName": "Jolt Transformation DSL", "identifiesControllerService": false, "sensitive": false},
          "jolt-spec": {"name": "jolt-spec", "displayName": "Jolt Specification", "identifiesControllerService": false, "sensitive": false}
        },
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["failure"],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "system-metrics-collector-001"
      },
      {
        "identifier": "update-attr-timestamp-001",
        "instanceIdentifier": "update-attr-timestamp-instance",
        "name": "UpdateAttribute - Add Timestamp",
        "comments": "Adds @timestamp attribute for Elasticsearch",
        "position": {"x": 0.0, "y": 600.0},
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-update-attribute-nar",
          "version": "1.23.2"
        },
        "properties": {
          "Delete Attributes Expression": null,
          "@timestamp": "${now():format('yyyy-MM-dd\\'T\\'HH:mm:ss.SSS\\'Z\\'')}",
          "elasticsearch.index": "nifi-system-metrics-${now():format('yyyy.MM.dd')}",
          "Store State": "Do not store state",
          "canonical-value-lookup-cache-size": "100"
        },
        "propertyDescriptors": {
          "Delete Attributes Expression": {"name": "Delete Attributes Expression", "displayName": "Delete Attributes Expression", "identifiesControllerService": false, "sensitive": false},
          "@timestamp": {"name": "@timestamp", "displayName": "@timestamp", "identifiesControllerService": false, "sensitive": false}
        },
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 25,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": [],
        "scheduledState": "ENABLED",
        "retryCount": 10,
        "retriedRelationships": [],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "10 mins",
        "componentType": "PROCESSOR",
        "groupIdentifier": "system-metrics-collector-001"
      },
      {
        "identifier": "put-es-system-001",
        "instanceIdentifier": "put-es-system-instance",
        "name": "PutElasticsearchJson - System Metrics",
        "comments": "Indexes system metrics to Elasticsearch",
        "position": {"x": 0.0, "y": 800.0},
        "type": "org.apache.nifi.processors.elasticsearch.PutElasticsearchJson",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-elasticsearch-client-service-nar",
          "version": "1.23.2"
        },
        "properties": {
          "el-rest-client-service": null,
          "el-rest-index": "${elasticsearch.index}",
          "el-rest-type": "_doc",
          "el-rest-id-attribute": null,
          "el-rest-bulk-header": null,
          "el-rest-output-error-documents": "false"
        },
        "propertyDescriptors": {
          "el-rest-client-service": {"name": "el-rest-client-service", "displayName": "Client Service", "identifiesControllerService": true, "sensitive": false},
          "el-rest-index": {"name": "el-rest-index", "displayName": "Index", "identifiesControllerService": false, "sensitive": false}
        },
        "style": {},
        "schedulingPeriod": "0 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "executionNode": "ALL",
        "penaltyDuration": "30 sec",
        "yieldDuration": "1 sec",
        "bulletinLevel": "WARN",
        "runDurationMillis": 0,
        "concurrentlySchedulableTaskCount": 1,
        "autoTerminatedRelationships": ["success", "failure", "retry"],
        "scheduledState": "ENABLED",
        "retryCount": 3,
        "retriedRelationships": ["retry"],
        "backoffMechanism": "PENALIZE_FLOWFILE",
        "maxBackoffPeriod": "1 min",
        "componentType": "PROCESSOR",
        "groupIdentifier": "system-metrics-collector-001"
      }
    ],
    "inputPorts": [],
    "outputPorts": [],
