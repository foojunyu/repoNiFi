            "seriesParams": [
              {"show": true, "type": "line", "mode": "normal", "data": {"label": "Heap Used", "id": "1"}, "valueAxis": "ValueAxis-1", "lineWidth": 2},
              {"show": true, "type": "line", "mode": "normal", "data": {"label": "Heap Max", "id": "2"}, "valueAxis": "ValueAxis-1", "lineWidth": 2, "drawLinesBetweenPoints": true}
            ],
            "addTooltip": true,
            "addLegend": true,
            "legendPosition": "right",
            "times": [],
            "addTimeMarker": false,
            "thresholdLine": {"show": true, "value": null, "width": 1, "style": "dashed", "color": "#E7664C"}
          },
          "aggs": [
            {"id": "1", "enabled": true, "type": "avg", "schema": "metric", "params": {"field": "heapUsedBytes", "customLabel": "Heap Used"}},
            {"id": "2", "enabled": true, "type": "avg", "schema": "metric", "params": {"field": "heapMaxBytes", "customLabel": "Heap Max"}},
            {"id": "3", "enabled": true, "type": "date_histogram", "schema": "segment", "params": {"field": "@timestamp", "interval": "auto", "min_doc_count": 1}}
          ]
