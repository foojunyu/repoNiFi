            "runStatus": { "type": "keyword" },
            "executionNode": { "type": "keyword" }
          }
        },
        "bytesReceived": { "type": "long" },
        "bytesSent": { "type": "long" },
        "bytesRead": { "type": "long" },
        "bytesWritten": { "type": "long" },
        "bytesTransferred": { "type": "long" },
