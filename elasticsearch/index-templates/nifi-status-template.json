        "input": {
          "properties": {
            "bytes": { "type": "long" },
            "count": { "type": "long" }
          }
        },
        "output": {
          "properties": {
            "bytes": { "type": "long" },
            "count": { "type": "long" }
          }
        },
        "queued": {
          "properties": {
            "bytes": { "type": "long" },
            "count": { "type": "long" }
          }
        },
        "read": {
          "properties": {
            "bytes": { "type": "long" },
            "count": { "type": "long" }
          }
        },
        "written": {
          "properties": {
            "bytes": { "type": "long" },
            "count": { "type": "long" }
          }
        },
        "received": {
          "properties": {
            "bytes": { "type": "long" },
            "count": { "type": "long" }
          }
        },
        "sent": {
          "properties": {
            "bytes": { "type": "long" },
            "count": { "type": "long" }
          }
        },
        "backPressureDataSizeThreshold": { "type": "keyword" },
        "backPressureObjectThreshold": { "type": "long" },
        "isBackPressureEnabled": { "type": "boolean" },
        "percentUseCount": { "type": "float" },
        "percentUseBytes": { "type": "float" },
        "sourceId": { "type": "keyword" },
        "sourceName": { "type": "keyword" },
        "destinationId": { "type": "keyword" },
        "destinationName": { "type": "keyword" }
